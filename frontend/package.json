{
  "name": "custody-spa",
  "version": "1.0.0",
  "private": true,
  "description": "Naguib Selim Charity — the new Angular SPA for the custody & expenses system (served by PHP as static files from public/app)",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4200",
    "build": "ng build",
    "build:analyze": "ng build --stats-json && source-map-explorer dist/**/*.js --html dist/bundle-report.html || ng build --stats-json",
    "watch": "ng build --watch --configuration development",
    "lint": "eslint \"src/**/*.ts\" \"src/**/*.html\"",
    "lint:styles": "stylelint \"src/styles/**/*.scss\"",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:palette": "node scripts/check-palette.mjs",
    "check:size": "node scripts/check-bundle-size.mjs",
    "check:readmes": "node scripts/check-readmes.mjs",
    "icons": "node scripts/build-icons.mjs",
    "fonts": "node scripts/build-fonts.mjs",
    "test": "ng test --watch=false --browsers=ChromeHeadless",
    "e2e": "playwright test --config=e2e/playwright.config.ts",
    "verify": "npm run lint && npm run lint:styles && npm run check:i18n && npm run build && npm run check:size && npm run check:palette && npm run check:readmes",
    "pack": "node scripts/pack.mjs",
    "bootstrap": "node scripts/bootstrap.mjs"
  },
  "dependencies": {
    "@angular/animations": "20.3.34",
    "@angular/common": "20.3.34",
    "@angular/compiler": "20.3.34",
    "@angular/core": "20.3.34",
    "@angular/forms": "20.3.34",
    "@angular/platform-browser": "20.3.34",
    "@angular/platform-browser-dynamic": "20.3.34",
    "@angular/router": "20.3.34",
    "@fontsource/amiri": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@ngx-translate/core": "18.1.0",
    "@ngx-translate/http-loader": "18.1.0",
    "@primeuix/themes": "3.1.0",
    "@tabler/icons": "3.50.0",
    "chart.js": "4.6.1",
    "gsap": "3.15.0",
    "primeng": "20.4.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "20.3.42",
    "@angular/cli": "20.3.42",
    "@angular/compiler-cli": "20.3.34",
    "@angular/language-service": "20.3.34",
    "@playwright/test": "1.55.1",
    "@types/jasmine": "5.1.9",
    "angular-eslint": "20.2.0",
    "eslint": "9.35.0",
    "jasmine-core": "5.10.0",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-jasmine": "5.1.0",
    "prettier": "3.6.2",
    "source-map-explorer": "2.5.3",
    "stylelint": "16.23.1",
    "stylelint-config-standard-scss": "15.0.1",
    "stylelint-no-unsupported-browser-features": "8.0.4",
    "stylelint-scss": "6.12.1",
    "typescript": "5.8.3",
    "typescript-eslint": "8.42.0"
  }
}
